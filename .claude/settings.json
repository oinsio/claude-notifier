{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./notify-hook.sh",
            "timeout": 10,
            "statusMessage": "Отправка уведомления..."
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "./notify-hook.sh",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
