# Telegram Bot Configuration
# Get bot token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Chat ID (can be obtained from @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# Enable/disable notifications (true/false)
NOTIFICATIONS_ENABLED=true

# Notification detail level (minimal/detailed)
# minimal - brief messages (event and tool only)
# detailed - full information (description, files, commands)
NOTIFICATION_LEVEL=detailed

# Messenger for sending notifications (telegram)
# Future support: slack, discord, etc.
MESSENGER=telegram

# Language for notification messages (en/ru)
# en - English messages
# ru - Russian messages (Русские сообщения)
LANGUAGE=en
