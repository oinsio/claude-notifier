# Telegram Bot Configuration
# Получите токен бота у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ID чата (можно получить у @userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here

# Включить/отключить уведомления (true/false)
NOTIFICATIONS_ENABLED=true

# Уровень детализации уведомлений (minimal/detailed)
# minimal - краткие сообщения (только событие и инструмент)
# detailed - полная информация (описание, файлы, команды)
NOTIFICATION_LEVEL=detailed

# Мессенджер для отправки уведомлений (telegram)
# В будущем: slack, discord, etc.
MESSENGER=telegram
