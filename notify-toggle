#!/usr/bin/env bash
# Переключатель уведомлений Claude Code

# Получаем реальный путь к скрипту (работает с symlink)
SCRIPT_PATH="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT_PATH" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
  SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
  [[ $SCRIPT_PATH != /* ]] && SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
done
SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
ENV_FILE="$SCRIPT_DIR/.env"

# Проверка существования .env
if [ ! -f "$ENV_FILE" ]; then
  echo "❌ Файл .env не найден: $ENV_FILE"
  exit 1
fi

# Получить текущий статус
get_status() {
  if grep -q "^NOTIFICATIONS_ENABLED=true" "$ENV_FILE" 2>/dev/null; then
    echo "enabled"
  else
    echo "disabled"
  fi
}

# Установить статус
set_status() {
  local new_value="$1"

  # Если строка существует - заменить, иначе добавить
  if grep -q "^NOTIFICATIONS_ENABLED=" "$ENV_FILE"; then
    sed -i.bak "s/^NOTIFICATIONS_ENABLED=.*/NOTIFICATIONS_ENABLED=$new_value/" "$ENV_FILE"
  else
    echo "NOTIFICATIONS_ENABLED=$new_value" >> "$ENV_FILE"
  fi

  rm -f "$ENV_FILE.bak"
}

# Основная логика
case "${1:-}" in
  on)
    set_status "true"
    echo "✅ Уведомления включены"
    ;;
  off)
    set_status "false"
    echo "🔕 Уведомления отключены"
    ;;
  "")
    status=$(get_status)
    if [ "$status" = "enabled" ]; then
      echo "✅ Уведомления: включены"
    else
      echo "🔕 Уведомления: отключены"
    fi
    ;;
  *)
    echo "Использование: notify-toggle [on|off]"
    echo "  on  - включить уведомления"
    echo "  off - отключить уведомления"
    echo "  (без аргументов) - показать текущий статус"
    exit 1
    ;;
esac
